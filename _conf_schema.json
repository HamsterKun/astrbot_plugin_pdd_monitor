{
  "connection": {
    "type": "object",
    "description": "📮 账号与出口",
    "items": {
      "cookie": {
        "type": "string",
        "description": "Cookie",
        "default": "",
        "hint": "必填，须含 PDDAccessToken。用日常主号，小号常被风控。"
      },
      "user_agent": {
        "type": "string",
        "description": "User-Agent",
        "default": "",
        "hint": "留空用内置 iPhone Safari，填同机 UA 最不易被识别。"
      },
      "proxy": {
        "type": "string",
        "description": "出口代理",
        "default": "",
        "hint": "留空直连。云服务器上必填。格式 socks5h://user:pass@host:port"
      }
    }
  },
  "fetch": {
    "type": "object",
    "description": "🌐 取数方式",
    "items": {
      "fetch_mode": {
        "type": "string",
        "description": "取数方式",
        "default": "browser",
        "options": [
          "browser",
          "http",
          "auto"
        ],
        "hint": "browser 用无头 Chromium，推荐。http 是旧路线，仅供排查。"
      },
      "warmup_home": {
        "type": "bool",
        "description": "先访问首页",
        "default": true,
        "hint": "取数前先开首页拿设备 Cookie。关掉后首次搜索常只拿到不渲染的空壳。"
      },
      "transport": {
        "type": "string",
        "description": "传输方式",
        "default": "auto",
        "options": [
          "auto",
          "curl_cffi",
          "httpx"
        ],
        "hint": "保持 auto。诊断里显示 httpx 说明 curl_cffi 没装上。"
      },
      "impersonate": {
        "type": "string",
        "description": "模拟指纹",
        "default": "safari_ios",
        "hint": "仅 curl_cffi 生效。填的名字当前版本不支持时自动回落，不影响使用。"
      },
      "request_timeout": {
        "type": "int",
        "description": "请求超时（秒）",
        "default": 15,
        "hint": "仅 http 取数时生效。浏览器取数看下一分区的超时。"
      }
    }
  },
  "browser": {
    "type": "object",
    "description": "🖥 浏览器",
    "items": {
      "browser_channel": {
        "type": "string",
        "description": "内核通道",
        "default": "",
        "hint": "留空用精简的无头壳。一直「系统繁忙」时改填 chromium 用完整内核。"
      },
      "browser_headless": {
        "type": "bool",
        "description": "无头运行",
        "default": true,
        "hint": "服务器没有桌面环境，保持开启。"
      },
      "browser_timeout": {
        "type": "int",
        "description": "取数超时（秒）",
        "default": 45,
        "hint": "打开页面到截获商品数据的总时限。走内网穿透时调到 60~90。"
      },
      "browser_auto_install": {
        "type": "bool",
        "description": "自动补装内核",
        "default": true,
        "hint": "首次取数会下载 Chromium，一百多 MB。关掉则只报错不自救。"
      },
      "browser_idle_minutes": {
        "type": "int",
        "description": "空闲退出（分钟）",
        "default": 10,
        "hint": "闲置这么久就让浏览器退出、把内存还给系统。0 关闭。"
      },
      "browser_max_searches": {
        "type": "int",
        "description": "单进程取数上限",
        "default": 12,
        "hint": "取满这么多次就重启浏览器，压住单轮内的内存增长。0 关闭。"
      }
    }
  },
  "pricing": {
    "type": "object",
    "description": "🔍 取价规则",
    "items": {
      "search_sort": {
        "type": "string",
        "description": "搜索排序",
        "default": "price",
        "options": [
          "price",
          "_price"
        ],
        "hint": "保持 price（价格升序）。改成 _price 会让「最低价」明显虚高。"
      },
      "keyword_filter_by_title": {
        "type": "bool",
        "description": "标题分词匹配",
        "default": true,
        "hint": "在前几条里挑最贴近关键词的，而不是直接取最便宜的。"
      },
      "title_match_top_n": {
        "type": "int",
        "description": "参与匹配的条数",
        "default": 5,
        "hint": "1~20。不影响请求次数，只影响匹配精度，5 条通常够用。"
      }
    }
  },
  "outlier": {
    "type": "object",
    "description": "📉 异常剔除",
    "items": {
      "filter_price_outliers": {
        "type": "bool",
        "description": "剔除离群价",
        "default": true,
        "hint": "先剔掉配件、支架、引流 SKU 这类明显偏离主体的条目。"
      },
      "outlier_k": {
        "type": "int",
        "description": "离群严格度",
        "default": 3,
        "hint": "1~6，越小剔得越多。默认 3，拿不准别动。"
      },
      "outlier_drop_percent": {
        "type": "int",
        "description": "剔除闸门（%）",
        "default": 30,
        "hint": "低于中位数这个比例才允许被剔，防止误杀真低价。填 100 等于关掉。"
      },
      "use_price_baseline": {
        "type": "bool",
        "description": "基准校准",
        "default": true,
        "hint": "多取一次综合排序当尺子。每个词多一次请求，基准缓存 6 小时。"
      },
      "baseline_floor_percent": {
        "type": "int",
        "description": "基准下沿（%）",
        "default": 60,
        "hint": "低于基准中位数的这个比例算不同档商品。调小更宽松。"
      },
      "model_must_match": {
        "type": "bool",
        "description": "型号整串校验",
        "default": true,
        "hint": "5070 不算 5070ti。关键词不含型号时自动跳过。"
      }
    }
  },
  "schedule": {
    "type": "object",
    "description": "🔔 巡检与推送",
    "items": {
      "check_interval_minutes": {
        "type": "int",
        "description": "巡检间隔（分钟）",
        "default": 30,
        "hint": "不建议低于 20。请求会摊平到这个间隔里，不会在开头集中打完。"
      },
      "notify_at_new_low": {
        "type": "bool",
        "description": "史低主动推送",
        "default": true,
        "hint": "刷新历史最低价时推送到已绑定的会话。"
      },
      "max_goods": {
        "type": "int",
        "description": "监控关键词上限",
        "default": 50,
        "hint": "每轮每个词一次请求。越多单轮越久，也越容易踩风控。"
      },
      "daily_report_time": {
        "type": "string",
        "description": "定时行情时间",
        "default": "",
        "hint": "如 20:00。留空表示不自动播报。"
      },
      "risk_backoff_max_hours": {
        "type": "int",
        "description": "限流冷却上限（小时）",
        "default": 8,
        "hint": "命中限流后按 1h、2h、4h… 退避，到这里封顶。"
      }
    }
  }
}
